APP_NAME=Code Repository Q&A Agent
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ── LLM Provider: DeepSeek (OpenAI-compatible) ──────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
DEEPSEEK_VECTOR_SIZE=2048

# ── Legacy OpenAI (optional, if not using DeepSeek) ─────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4.1

# ── Infrastructure ───────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
POSTGRES_DSN=postgresql://repoqa:repoqa@postgres:5432/repoqa
REDIS_URL=redis://redis:6379/0

# ── Usage Quota (set to 0 to disable) ────────────────────────────────
USAGE_QUOTA_MAX_CHAT_CALLS=5000
USAGE_QUOTA_MAX_EMBEDDING_CALLS=50000
USAGE_QUOTA_DAILY_TOKEN_LIMIT=100000000

# ── Repository Storage (for Git URL cloning) ─────────────────────────
REPO_STORAGE_ROOT=/data/repoqa/repos
REPO_MAX_COUNT=20
REPO_TTL_HOURS=72
GIT_CLONE_TIMEOUT=120
